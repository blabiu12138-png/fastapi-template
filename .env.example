# 可直接留空 DATABASE_URL / REDIS_URL，以基础 HTTP 服务启动。
APP_NAME=FastAPI Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=[]
DEPENDENCY_TIMEOUT_SECONDS=5

# 安装 db extra 和对应驱动后，选择一种连接方式；留空则不启用数据库。
# SQLite（uv sync --extra db --extra sqlite；路径相对于进程工作目录）：
# DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL（uv sync --extra db --extra postgres）：
# DATABASE_URL=postgresql+asyncpg://app:replace-me@localhost:5432/app
# MySQL（uv sync --extra db --extra mysql）：
# DATABASE_URL=mysql+aiomysql://app:replace-me@localhost:3306/app?charset=utf8mb4
DATABASE_URL=

# 安装 redis extra 后配置。
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# 仅供 Docker 构建：例如 --extra db --extra sqlite 或 --extra redis。
# Compose 只启动应用，外部数据库 / Redis 需单独提供。
UV_EXTRAS=
